# Fonte da tabela FIPE: "mock" (padrão, dados de exemplo) ou "parallelum" (API pública da FIPE).
FIPE_MODE=mock

# Token da Power API de cada cliente. O nome segue o campo crm.tokenEnv do cliente.
# Gere em Power CRM > Minha empresa > Integrações > Power API.
POWER_TOKEN_DEMO=
POWER_TOKEN_SULMINAS=
POWER_TOKEN_VIX=

# URL base da Power API (ver docs/power-api.md).
POWER_API_BASE=https://api.powercrm.com.br

# Endereço público desta instalação. Necessário quando o checkout roda em cliente.com.br/cotacao.
ASSET_PREFIX=

# Chave para abrir o painel em produção (/painel?chave=...).
PAINEL_CHAVE=
